# Optional: Copy to .env.local for local dev or configure in Vercel Project Settings -> Environment Variables
GEMINI_API_KEY=your_gemini_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=nPczCjzI2devNBz1zQrb

# Optional Cost-Controlled Veo Hero-Shot Mode (strictly false by default; only animates scenes with is_hero_shot: true)
ENABLE_VEO_HERO_SHOTS=false

# ============================================================================
# Self-Upgrading Anime Director & Anti-"Aneh" Quality Control (Supabase)
# NEVER commit real secrets or expose SUPABASE_SECRET_KEY / APP_ACCESS_PIN to frontend!
# ============================================================================
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLISHABLE_KEY_HERE
SUPABASE_SECRET_KEY=sb_secret_YOUR_SECRET_KEY_HERE
APP_ACCESS_PIN=create_your_own_secret_pin_here
